# =====================================================
# Test Environment Configuration
# Copy from .env and modify database name
# =====================================================

# Database Configuration (TEST DATABASE)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatchiu_test
DB_USER=postgres
DB_PASSWORD=your_password_here

# Application
NODE_ENV=test
PORT=3001

# JWT (same as production for consistency)
JWT_SECRET=your_jwt_secret_here

# Feature Flags - Test Optimized Service
USE_OPTIMIZED_PAYMENT_SERVICE=true
OPTIMIZED_SERVICE_ROLLOUT_PERCENTAGE=100

# Logging
LOG_LEVEL=debug
