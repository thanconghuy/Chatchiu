# AccessTrade API Configuration
ACCESSTRADE_API_TOKEN=your_access_token_here
ACCESSTRADE_API_URL=https://api.accesstrade.vn/v1

# Server Configuration
PORT=3000

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=7d

# Commission Split (percentage that goes to user, rest goes to platform)
COMMISSION_SPLIT=0.7

# Conversion Sync Configuration (DISABLED - Use manual sync from admin panel)
# Auto sync via cron job is disabled by default
# Only admin can trigger sync manually via Admin Tools page
# SYNC_CRON_SCHEDULE=0 */3 * * *  # Uncomment to enable auto sync every 3 hours
# SYNC_ON_START=false              # Don't sync on server start

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
