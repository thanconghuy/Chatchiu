# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

NODE_ENV=development
PORT=3007

# ==========================================
# SECURITY - REQUIRED
# ==========================================
# Generate strong JWT secret (32+ random characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-CHANGE-THIS
JWT_EXPIRES_IN=7d

# ==========================================
# DATABASE - REQUIRED
# ==========================================
# Neon PostgreSQL Database
# Get from: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ==========================================
# ACCESSTRADE API - REQUIRED
# ==========================================
# Get from: https://accesstrade.vn
ACCESSTRADE_API_TOKEN=your-accesstrade-api-token-here
ACCESSTRADE_API_URL=https://api.accesstrade.vn/v1

# Cashback Commission Split (70% to users)
COMMISSION_SPLIT=0.7

# ==========================================
# GOOGLE OAUTH - OPTIONAL
# ==========================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3007/api/auth/google/callback

# ==========================================
# NEON AUTH (STACK AUTH) - OPTIONAL
# ==========================================
# Get from: https://console.neon.tech > Your Project > Auth
# Note: Only works with Next.js/React
STACK_PROJECT_ID=your-stack-project-id
STACK_PUBLISHABLE_CLIENT_KEY=pck_your-publishable-key
STACK_SECRET_SERVER_KEY=ssk_your-secret-key-KEEP-SECRET

# ==========================================
# PRODUCTION SETTINGS
# ==========================================
# Comma-separated list of allowed origins for CORS
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# ==========================================
# EMAIL (SMTP) - REQUIRED FOR PASSWORD RESET
# ==========================================
# SMTP Configuration for sending password reset emails
# Option 1: Gmail (Recommended for development)
# - Enable 2-factor authentication in your Gmail account
# - Create App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=ChatChiu Cashback <noreply@chatchiu.com>

# Option 2: Other SMTP providers
# - SendGrid: smtp.sendgrid.net (port 587)
# - Mailgun: smtp.mailgun.org (port 587)
# - Amazon SES: email-smtp.region.amazonaws.com (port 587)

# Frontend URL for reset password link
FRONTEND_URL=http://localhost:3007

# ==========================================
# OPTIONAL SETTINGS
# ==========================================
# Conversion Sync (DISABLED by default - Use manual sync from admin panel)
# SYNC_CRON_SCHEDULE=0 */3 * * *
# SYNC_ON_START=false
