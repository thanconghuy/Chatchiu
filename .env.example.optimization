# =====================================================
# Payment Module Optimization - Environment Variables
# =====================================================

# Feature Flag: Enable optimized payment service
# Set to 'true' to use the optimized service
# Set to 'false' to use the original service
# Default: false (safe default)
USE_OPTIMIZED_PAYMENT_SERVICE=false

# Rollout Percentage: Gradual rollout control (0-100)
# Only applies when USE_OPTIMIZED_PAYMENT_SERVICE=true
# Examples:
#   10  = 10% of users get optimized service
#   50  = 50% of users get optimized service
#   100 = 100% of users get optimized service (full rollout)
# Default: 100 (when optimized service is enabled, use it for everyone)
OPTIMIZED_SERVICE_ROLLOUT_PERCENTAGE=100

# =====================================================
# Deployment Strategy Examples
# =====================================================

# Phase 1: Disabled (after applying indexes)
# USE_OPTIMIZED_PAYMENT_SERVICE=false

# Phase 2: 10% rollout (testing phase)
# USE_OPTIMIZED_PAYMENT_SERVICE=true
# OPTIMIZED_SERVICE_ROLLOUT_PERCENTAGE=10

# Phase 3: 50% rollout (if 10% looks good)
# USE_OPTIMIZED_PAYMENT_SERVICE=true
# OPTIMIZED_SERVICE_ROLLOUT_PERCENTAGE=50

# Phase 4: 100% rollout (full deployment)
# USE_OPTIMIZED_PAYMENT_SERVICE=true
# OPTIMIZED_SERVICE_ROLLOUT_PERCENTAGE=100

# =====================================================
# Monitoring Notes
# =====================================================
# - Monitor error rates at each phase
# - Monitor response times via logs
# - Check database CPU and memory usage
# - Monitor PM2 logs: pm2 logs chatchiu-api
# - If error rate increases, decrease percentage or rollback
