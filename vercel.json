{
  "version": 2,
  "builds": [
    {
      "src": "server-cashback.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "/admin/admin.css",
      "dest": "/frontend/admin/admin.css"
    },
    {
      "src": "/api/(.*)",
      "dest": "server-cashback.js"
    },
    {
      "src": "/health",
      "dest": "server-cashback.js"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|jpeg|gif|svg|ico))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "server-cashback.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
