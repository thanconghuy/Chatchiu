{
  "version": 2,
  "builds": [
    {
      "src": "server-cashback.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server-cashback.js"
    },
    {
      "src": "/health",
      "dest": "server-cashback.js"
    },
    {
      "src": "/(.*)",
      "dest": "server-cashback.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
